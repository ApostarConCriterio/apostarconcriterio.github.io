    if (r.getResponseCode() !== 200) { log_('cuotas', 'the-odds-api ' + c.k, 'error', 0, Date.now() - t0, 'HTTP ' + r.getResponseCode() + ' ' + r.getContentText().slice(0, 200)); return; }
