id;grid-template-columns:repeat(2,minmax(0,1fr));gap:8px 10px;margin:10px 0}@media(min-width:760px){.efs{grid-template-columns:repeat(4,minmax(0,1fr))}}\n.ef label{display:block;font-size:12.5px;color:var(--mu);margin-bottom:3px}.ef input,.ef select{width:100%;min-width:0;padding:8px 9px;border:1.5px solid var(--li);border-radius:9px;background:var(--bg);font-size:16px}\n.cfg{display:grid;grid-template-columns:1fr 100px;gap:8px 12px;align-items:center;margin:10px 0}\n.cfg input{padding:8px;border:1.5px solid var(--li);border-radius:8px;background:var(--bg);font-size:16px;width:100%}\n\n.ans{border-radius:var(--rad);padding:14px 14px 12px;margin:0 0 12px;background:var(--pa);border:1px solid var(--li)}\n.ans.y{background:#fff8e1;border-color:#f3d36b}\n.ans h3{margin:0 0 4px;font-size:18px}.ans p{margin:0;color:var(--mu);font-size:14px}\n.ans .it{display:flex;justify-content:space-between;gap:10px;align-items:center;width:100%;text-align:left;background:var(--bg);border:1px solid var(--li);border-radius:10px;padding:9px 11px;margin-top:8px;cursor:pointer;font-size:14.5px}\n.ans .it b{display:block}.ans .it small{color:var(--mu)}.ans .it .v{font-weight:700;color:var(--ok);white-space:nowrap}\n.ans .lk{background:none;border:0;color:var(--g);font-weight:700;padding:8px 0 0;cursor:pointer;font-size:14px}\n.dbar{display:flex;gap:8px;align-items:center;margin:0 0 6px}\n.gform{display:grid;grid-template-columns:1fr 1fr;gap:8px;margin-top:10px}\n.gform label{display:flex;flex-direction:column;gap:4px;font-size:13px;color:var(--mu);min-width:0}\n.gform select,.gform input{width:100%;min-width:0;padding:9px 10px;border:1.5px solid var(--li);border-radius:9px;background:var(--bg);color:var(--tx);font-size:16px}\n.gform .w2{grid-column:1/-1}\n.m1{grid-template-columns:44px 1fr auto!important}\n.m1 .t{display:flex;flex-direction:column;align-items:flex-start;gap:4px}\n.m1 .n{display:flex;flex-direction:column;white-space:normal!important;line-height:1.25}.m1 .n>span{overflow:hidden;text-overflow:ellipsis;white-space:nowrap}.m1 .n .badge{align-self:flex-start;margin-top:3px}\n.oc{display:grid;grid-auto-flow:column;grid-auto-columns:44px;gap:4px;text-align:center;font-variant-numeric:tabular-nums}\n.oc>span{display:flex;flex-direction:column;border-radius:8px;padding:3px 0;background:var(--pa)}\n.oc b{font-size:14px}.oc small{font-size:10.5px;color:var(--mu)}\n.oc .vg{background:#dff3e4;outline:1.5px solid #2e9a57}.oc .vg b{color:#1d7a40}\n.ohead{display:flex;justify-content:space-between;align-items:center;gap:8px;margin:4px 0 2px}\n.oc.ol>span{background:none;padding:0;font-size:12px;font-weight:700;color:var(--mu)}\n.omode{display:flex;background:var(--pa);border-radius:999px;padding:2px}\n.omode button{border:0;background:none;border-radius:999px;padding:5px 10px;font-size:13px;font-weight:700;color:var(--mu);cursor:pointer}\n.omode button.on{background:var(--bg);color:var(--tx);box-shadow:0 1px 2px rgba(0,0,0,.12)}\n.fd{display:inline-block;width:8px;height:8px;border-radius:50%;background:#aaa}.fd.ok{background:#2e9a57}.fd.old{background:#e0a800}\nbutton.lgh{width:100%;border:0;background:none;padding:6px 0;cursor:pointer;text-align:left}\n.mhead{position:sticky;top:0;z-index:5}\n.cmp td input{width:100%;min-width:0;padding:7px 6px;border:1.5px solid var(--li);border-radius:8px;font-size:16px;background:var(--bg);color:var(--tx);text-align:center}\n.cmp small{display:block;font-size:11px;color:var(--mu)}\n.cmp .vd{display:block;font-size:11.5px;font-weight:700}.cmp .vd.si{color:#1d7a40}.cmp .vd.no{color:#b3261e}\n.sports{display:flex;gap:6px;margin:2px 0 10px;overflow-x:auto;scrollbar-width:none}\n.sports::-webkit-scrollbar{display:none}\n.sports button{flex:1 0 auto;border:1.5px solid var(--li);background:var(--bg);color:var(--tx);border-radius:12px;padding:8px 12px;font-weight:700;font-size:14.5px;cursor:pointer;display:flex;gap:6px;align-items:center;justify-content:center}\n.sports button small{font-weight:600;color:var(--mu);font-size:12px}\n.sports button.on{background:var(--tx);color:var(--bg);border-color:var(--tx)}\n.sports button.on small{color:inherit;opacity:.75}\n.orow .fo{font-size:13px;font-weight:700;color:var(--mu);white-space:nowrap;font-variant-numeric:tabular-nums}\n.days{display:flex;background:var(--pa);border-radius:999px;padding:3px;flex:1;min-width:0}\n.days button{flex:1;border:0;background:none;border-radius:999px;padding:8px 6px;font-weight:700;font-size:14.5px;color:var(--mu);cursor:pointer;white-space:nowrap}\n.days button.on{background:var(--bg);color:var(--tx);box-shadow:0 1px 3px rgba(0,0,0,.12)}\n.fbtn{border:1.5px solid var(--li);background:var(--bg);border-radius:999px;padding:8px 14px;font-weight:700;font-size:14.5px;cursor:pointer;white-space:nowrap}\n.fbtn.act{border-color:var(--g);color:var(--g)}\n#filtPanel{margin:6px 0 4px}\n.lgh{display:flex;justify-content:space-between;align-items:baseline;gap:8px;margin:14px 0 4px;font-weight:700;font-size:14px;color:var(--tx)}\n.lgh small{color:var(--mu);font-weight:600}\n.m1{display:grid;grid-template-columns:46px 1fr auto;gap:8px;align-items:center;width:100%;text-align:left;border:0;border-bottom:1px solid var(--li);border-radius:0;box-shadow:none;margin:0;background:none;padding:11px 2px;cursor:pointer;font-size:15px}\n.m1 .t{font-weight:700;font-variant-numeric:tabular-nums;color:var(--mu)}\n.m1 .n{min-width:0;overflow:hidden;text-overflow:ellipsis;white-space:nowrap}.m1 .n i{font-style:normal;color:var(--mu);font-size:13px;padding:0 3px}\n.more{display:block;width:100%;margin:12px 0 4px;border:1.5px dashed var(--li);background:none;border-radius:10px;padding:10px;font-weight:700;color:var(--g);cursor:pointer}\nfooter{border-top:4px solid var(--g);background:var(--pa);padding:14px 0 18px;font-size:13px;color:var(--mu)}\nfooter b{color:var(--tx)}\n</style>\n\n<header><div class=\"wrap\">\n  <div class=\"logo\" aria-hidden=\"true\"></div>\n  <div><h1>Apostar con criterio</h1><p>Para decidir mejor, no para apostar más.</p></div>\n  <div class=\"age\" title=\"Solo mayores de 18\">+18</div>\n</div></header>\n\n<nav class=\"bottom\" aria-label=\"Secciones\"><div class=\"wrap\">\n  <button data-go=\"partidos\" class=\"on\"><svg viewBox=\"0 0 24 24\" fill=\"none\" stroke=\"currentColor\" stroke-width=\"2\"><circle cx=\"12\" cy=\"12\" r=\"9\"/><path d=\"M12 7l4 3-1.5 4.5h-5L8 10z\"/></svg>Partidos</button>\n  <button data-go=\"oportunidades\"><svg viewBox=\"0 0 24 24\" fill=\"none\" stroke=\"currentColor\" stroke-width=\"2\"><path d=\"M12 3l2.6 5.6 6.1.7-4.5 4.2 1.2 6L12 16.6 6.6 19.5l1.2-6L3.3 9.3l6.1-.7z\"/></svg>Señales</button>\n  <button data-go=\"mas\"><svg viewBox=\"0 0 24 24\" fill=\"none\" stroke=\"currentColor\" stroke-width=\"2\"><circle cx=\"5\" cy=\"12\" r=\"1.6\"/><circle cx=\"12\" cy=\"12\" r=\"1.6\"/><circle cx=\"19\" cy=\"12\" r=\"1.6\"/></svg>Más</button>\n</div></nav>\n\n<main><div class=\"wrap\">\n\n<section class=\"view on\" id=\"v-partidos\">\n  <button class=\"strip\" id=\"strip\" aria-label=\"Estado de los datos\"><span class=\"dot load\"></span><span id=\"stripTxt\">Cargando datos…</span><span class=\"arr\">›</span></button>\n  <div class=\"sports\" id=\"sports\" role=\"group\" aria-label=\"Deporte\"></div>\n  <div id=\"answer\"></div>\n  <input class=\"search\" id=\"q2\" type=\"search\" placeholder=\"Buscar equipo, jugador o liga\" aria-label=\"Buscar equipo, jugador o liga\" style=\"width:100%;margin:0 0 8px\">\n  <div class=\"dbar\"><div class=\"days\" id=\"days\" role=\"group\" aria-label=\"Días\"><button data-d=\"ahora\">Ahora</button><button data-d=\"hoy\" class=\"on\">Hoy</button><button data-d=\"man\">Mañana</button><button data-d=\"todo\">Más días</button></div><button class=\"fbtn\" id=\"filtBtn\" aria-expanded=\"false\">Filtrar</button></div>\n  <div id=\"filtPanel\" hidden><div class=\"chips\" id=\"chips\" role=\"group\" aria-label=\"Filtros\"></div>\n  <div class=\"row2\"><input class=\"search\" id=\"q\" type=\"search\" placeholder=\"Buscar equipo o liga\" aria-label=\"Buscar equipo o liga\">\n    <select class=\"sel\" id=\"sort\" aria-label=\"Ordenar\"><option value=\"time\">Por hora</option><option value=\"ev\">Por valor</option><option value=\"fav\">Por favorito</option></select></div></div>\n  <div id=\"region\" class=\"loading\"><div id=\"topAlert\"></div><div class=\"count\" id=\"count\"></div><div id=\"list\"><div class=\"skel\"></div><div class=\"skel\"></div><div class=\"skel\"></div><div class=\"skel\"></div><div class=\"skel\"></div><div class=\"skel\"></div></div><div id=\"pastBox\"></div></div>\n</section>\n\n<section class=\"view\" id=\"v-ficha\"></section>\n\n<section class=\"view\" id=\"v-oportunidades\"></section>\n\n<section class=\"view\" id=\"v-herramientas\">\n  <div id=\"toolHome\">\n    <h2>Herramientas</h2>\n    <p class=\"lead\">Elegí qué querés saber. Cada herramienta trae un ejemplo cargado: cambiá los números por los tuyos.</p>\n    <div class=\"big3\" id=\"big3\"></div>\n    <div id=\"groups\"></div>\n  </div>\n  <div id=\"toolView\" hidden></div>\n</section>\n\n<section class=\"view\" id=\"v-registro\">\n  <div class=\"tabs2\" id=\"regTabs\"><button class=\"on\" data-rt=\"mias\">Mis apuestas</button><button data-rt=\"sistema\">Predicciones del sistema</button></div>\n  <div id=\"rt-mias\">\n  <p class=\"lead\">Anotá cada apuesta y después marcá cómo salió. Se guarda solo en este celular o computadora: copiala a Excel de vez en cuando como respaldo.</p>\n  <div class=\"tiles\" id=\"tiles\"></div>\n  <div id=\"chartBox\"></div>\n  <div class=\"limit\" id=\"limitBox\"></div>\n  <div id=\"breakBox\"></div>\n  <h3>Anotar una apuesta</h3>\n  <div class=\"addf\">\n    <input id=\"aDesc\" placeholder=\"¿A qué apostaste? (ej. Gana Boca)\" aria-label=\"Descripción\">\n    <input id=\"aOdd\" inputmode=\"decimal\" placeholder=\"Cuota\" aria-label=\"Cuota\">\n    <input id=\"aStake\" inputmode=\"decimal\" placeholder=\"Monto $\" aria-label=\"Monto\">\n    <button class=\"btn\" id=\"aAdd\">Anotar</button>\n  </div>\n  <div class=\"addx\">\n    <select id=\"aMk\" aria-label=\"Mercado\"><option value=\"\">Mercado (opcional)</option><option>1X2</option><option>Doble oportunidad</option><option>Empate no apuesta</option><option>Más/menos goles</option><option>Hándicap asiático</option><option>Ambos marcan</option><option>Otro</option></select>\n    <input id=\"aBook\" list=\"aBooks\" placeholder=\"Casa (opcional)\" aria-label=\"Casa\"><datalist id=\"aBooks\"><option>Betano</option><option>BetWarrior</option><option>Casino Club</option><option>Bet365</option><option>Codere</option><option>Bplay</option></datalist>\n    <input id=\"aLg\" placeholder=\"Liga (opcional)\" aria-label=\"Liga\">\n  </div>\n  <p class=\"meta\" id=\"aMsg\"></p>\n  <h3>Mis apuestas</h3>\n  <div id=\"bets\"></div>\n  <details><summary>Mi banca, mi límite y pausa</summary>\n    <div class=\"fields\" style=\"margin-top:10px\">\n      <div class=\"f\"><label for=\"sBank\">Mi banca: la plata que separé para apostar ($)</label><input id=\"sBank\" inputmode=\"decimal\"><small>Con esto se calcula tu unidad: el 1% de la banca.</small></div>\n      <div class=\"f\"><label for=\"sLimit\">Lo máximo que acepto perder ($)</label><input id=\"sLimit\" inputmode=\"decimal\" placeholder=\"Sin límite\"></div>\n      <div class=\"f\"><label for=\"sPer\">Por</label><select id=\"sPer\"><option value=\"w\">Semana</option><option value=\"m\">Mes</option></select></div>\n    </div>\n    <p><button class=\"btn lt sm\" id=\"pauseBtn\">Pausar el registro 7 días</button></p>\n    <p class=\"meta\" id=\"pauseMsg\"></p>\n  </details>\n  <p><button class=\"btn gh sm\" id=\"csv\">Copiar mis apuestas (para Excel)</button></p>\n  <textarea id=\"csvBox\" hidden readonly style=\"width:100%;min-height:110px;font:13px monospace;background:var(--bg);color:var(--tx);border:1px solid var(--li);border-radius:8px;padding:8px\"></textarea>\n  </div>\n  <div id=\"rt-sistema\" hidden></div>\n</section>\n\n<section class=\"view\" id=\"v-mas\"></section>\n\n</div></main>\n\n<footer><div class=\"wrap\"><b>Solo mayores de 18, en sitios habilitados (.bet.ar).</b> Datos: football-data.co.uk. Esta página no es una casa de apuestas ni recibe apuestas. Si el juego dejó de ser un juego: CABA 0800-666-6006 · Provincia de Buenos Aires 0800-444-4000.</div></footer>\n\n<div class=\"sheet\" id=\"sheet\" role=\"dialog\" aria-modal=\"true\" aria-labelledby=\"shT\"><div class=\"box\"><h4 id=\"shT\"></h4><div id=\"shB\"></div><button class=\"btn\" id=\"shX\" style=\"width:100%;margin-top:10px\">Entendido</button></div></div>\n\n<script>\nconst GL={cuota:[\"Cuota decimal\",\"Lo que te paga la casa por cada peso apostado, incluyendo lo que pusiste.\",\"La ganancia limpia es (cuota − 1) × monto. Las cuotas decimales son las que usan las casas argentinas.\",\"$1.000 a cuota 2,50: si ganás cobrás $2.500, o sea, ganás $1.500.\"],implicita:[\"Probabilidad implícita\",'La chance que \"esconde\" una cuota: 1 ÷ cuota.',\"Incluye la ganancia de la casa, por eso las implícitas de un partido suman más de 100%. No es la probabilidad real: es la que la casa usa para cobrarte.\",\"Cuota 2,50 → 1 ÷ 2,50 = 40%.\"],margen:[\"Margen de la casa\",\"Lo que se queda la casa: cuánto suman las probabilidades implícitas por encima de 100%.\",\"Se calcula como Σ(1/cuota) − 1 con todas las opciones de un mercado. Un margen de 3% es bajo; más de 8% es caro. Cambia según la casa y el partido.\",\"2,10 / 3,30 / 3,60 → 47,6% + 30,3% + 27,8% = 105,7%: margen de 5,7%.\"],justa:[\"Cuota justa\",\"La cuota que habría que pagar si nadie se quedara con nada: 100 ÷ probabilidad.\",\"Sale de la probabilidad sin margen (estimada). Si una casa paga más que la cuota justa, la apuesta tiene valor esperado positivo según esa estimación.\",\"Probabilidad 36,4% → cuota justa 2,75.\"],sinmargen:[\"Quitar el margen (método de potencia)\",\"Cómo se pasa de las cuotas de una casa a probabilidades que sumen 100%.\",'Se eleva cada probabilidad implícita a un mismo exponente k hasta que sumen 100%. Le saca más margen a los batacazos que a los favoritos, porque las casas cargan más margen ahí (sesgo favorito–batacazo). Es una estimación, no la probabilidad \"verdadera\".',\"Implícitas 47,6/30,3/27,8 → sin margen ≈ 45,8 / 28,5 / 25,7.\"],consenso:[\"Probabilidad de mercado (consenso)\",\"La probabilidad sin margen que surge de un mercado muy líquido: Betfair Exchange, Pinnacle o el promedio de muchas casas.\",\"Es la referencia de esta página: en la validación con 62.606 partidos predijo mejor que el modelo propio. Se usa Betfair si sus cuotas son coherentes; si no, Pinnacle; si no, el promedio.\",\"Betfair 2,24 / 3,85 / 2,34 → 42% / 24% / 34%.\"],estimada:[\"Probabilidad estimada\",\"La chance que calcula un método (mercado sin margen o un modelo). Siempre es una estimación con error.\",\"Cuanto más chica la muestra o más incompletos los datos, mayor el error. Por eso la página muestra de dónde sale cada probabilidad y no la presenta como certeza.\",'\"Gana el local: 45% (mercado sin margen)\".'],modelo:[\"Modelo propio (experimental)\",\"Un cálculo de la página basado en goles de partidos anteriores: fuerza de ataque y defensa de cada equipo y ventaja de local.\",\"Versión poisson-fuerzas-v1. En la prueba fuera de muestra (9.081 partidos de 2025/26 y 2026/27) predijo PEOR que el mercado (log loss 1,033 contra 1,000). Por eso se muestra solo como referencia y no genera señales.\",\"Si el modelo dice 30% y el mercado 45%, lo más probable es que el modelo esté equivocado.\"],ev:[\"Valor esperado (EV)\",\"Cuánto ganarías o perderías en promedio por cada peso, si apostaras muchas veces en situaciones iguales.\",\"EV = probabilidad × cuota − 1, para apuestas que se ganan o se pierden enteras. Con devoluciones (hándicap asiático, empate no apuesta) hay que modelar la liquidación completa. Un EV positivo estimado no garantiza nada: puede venir de un error de estimación.\",\"Cuota 2,88 y probabilidad 36,4% → 2,88 × 0,364 − 1 = +4,8%.\"],oportunidad:[\"Señal / oportunidad\",\"Una cuota que paga más que la cuota justa del mercado, dentro de los límites de la regla.\",\"Regla: valor entre 2% y 25% (más de 25% suele ser un dato roto) y cuota de 8 o menos. Solo cuenta si el partido no empezó y la cuota es reciente. Los umbrales se cambian en Más → Ajustes.\",'\"Paga 5% de más, conviene si tu casa paga 2,80 o más\".'],roi:[\"Rendimiento (ROI / yield)\",\"Ganancia neta dividida por lo apostado.\",\"Con apuestas de 1 unidad, ROI y yield son lo mismo. Hace falta una muestra grande para que signifique algo: con 100 apuestas a cuota 3, el ROI varía ±20% solo por azar.\",\"Apostaste $100.000 en total y ganaste $3.000 → ROI +3%.\"],muestra:[\"Tamaño de muestra\",\"Cuántos casos hay detrás de un número.\",\"Con pocos casos, un resultado puede ser pura suerte. La página muestra el margen de error (±) del rendimiento: si incluye el cero, no está demostrado que haya ventaja.\",\"+2,1% ± 2,7% → podría ser −0,6% o +4,8%: no está demostrado.\"],varianza:[\"Varianza y rachas\",\"Cuánto se mueven los resultados alrededor del promedio.\",\"Con cuotas altas la varianza es mayor: rachas de 10 o más derrotas seguidas son normales aun con ventaja. El simulador de Herramientas lo muestra.\",\"Cuota 3,50: perder 8 seguidas pasa en 1 de cada 10 temporadas de 100 apuestas.\"],drawdown:[\"Caída máxima (drawdown)\",\"Lo máximo que bajó la banca desde un pico.\",\"En el backtest de la regla, la caída máxima fue de 99 unidades en 8 temporadas. Con apuestas de 1% de la banca, eso es casi toda la banca: por eso se recomienda la unidad fija.\",\"Llegaste a +40 unidades y bajaste a −10: caída de 50.\"],clv:[\"Le gané al cierre (CLV)\",\"Si la cuota que tomaste era mejor que la cuota justa al cierre del mercado.\",\"El mercado al cierre es la mejor estimación disponible. Ganarle seguido es la señal más confiable de una ventaja real, más que el resultado, que tiene mucha suerte. Definición usada: cuota tomada × probabilidad justa de cierre − 1.\",\"Tomaste 3,20 y al cierre lo justo era 2,95: CLV +8%.\"],xg:[\"Goles esperados (xG / xGA)\",'Cuántos goles \"merecía\" un equipo por la calidad de las situaciones que tuvo (xG) o que le generaron (xGA).',\"Solo se muestra cuando la fuente lo publica (por ahora, algunas ligas europeas desde 2026/27). Con pocos partidos es ruidoso.\",\"xG 1,8 y xGA 0,9: creó el doble de peligro del que concedió.\"],golesesp:[\"Goles esperados del partido\",\"Cuántos goles se esperan en total, según las cuotas de más/menos 2,5 goles.\",\"Se calcula con la Fórmula Espejo (λ = 6,0675p³ − 6,6p² + 6,0653p + 0,5286, con p = probabilidad de más de 2,5) y se reparte entre local y visitante según la diferencia de probabilidades.\",\"Más de 2,5 al 50% → λ ≈ 2,7 goles.\"],forma:[\"Forma reciente\",\"Cómo le fue al equipo en sus últimos partidos de liga.\",\"Siempre con la cantidad de partidos y las fechas. Una racha corta no predice mucho: el modelo y el mercado ya la tienen en cuenta.\",\"GEPEG = ganó, empató, perdió, empató, ganó.\"],fuerza:[\"Fuerza de ataque y defensa\",\"Cuántos goles hace y recibe un equipo comparado con el promedio de su liga.\",\"El modelo propio las calcula con todos los partidos de los últimos 2 años, dando más peso a los recientes (vida media de 180 días) y achicando las muestras chicas hacia el promedio.\",\"Ataque 1,2 = hace 20% más goles que el promedio.\"],local:[\"Ventaja de local\",\"Los locales hacen más goles y ganan más seguido.\",\"Se mide por liga: en la mayoría de las ligas europeas el local hace unos 1,45 goles y el visitante 1,2 por partido.\",\"\"],poisson:[\"Poisson\",\"Un modelo que reparte la cantidad de goles de cada equipo alrededor de su promedio esperado.\",\"Con los goles esperados de cada equipo se arma una tabla de resultados (0-0, 1-0, 1-1…) y de ahí salen las probabilidades de todos los mercados de goles. Supone que los goles de un equipo no dependen de los del otro.\",\"Local 1,5 y visitante 1,1 goles esperados → 1-1 es el resultado más probable (≈ 13%).\"],dixon:[\"Ajuste Dixon-Coles\",\"Una corrección de Poisson para los resultados bajos (0-0, 1-0, 0-1, 1-1).\",\"Poisson subestima los empates bajos. El ajuste los corrige con un parámetro ρ = −0,13.\",\"\"],calibracion:[\"Calibración\",\"Si las probabilidades se cumplen: de los casos con 30%, ¿pasa 3 de cada 10?\",\"Se agrupan las predicciones por rangos y se compara la probabilidad promedio con lo que pasó. El mercado está bien calibrado en casi todos los rangos.\",\"\"],brier:[\"Brier score\",\"Mide el error de las probabilidades: cuanto más bajo, mejor.\",\"Promedio de (probabilidad − resultado)² sumado sobre local, empate y visitante. Repartir 33% a cada uno da 0,667.\",\"Mercado 0,598 vs modelo 0,620 → el mercado predice mejor.\"],logloss:[\"Log loss\",\"Otra medida del error que castiga mucho estar muy seguro y equivocarse.\",\"Promedio de −ln(probabilidad asignada a lo que pasó). Repartir 33% a cada uno da 1,099.\",\"Mercado 1,000 vs modelo 1,033.\"],sobreajuste:[\"Sobreajuste\",\"Cuando un método se ajusta tanto a los datos pasados que copia el ruido y falla con datos nuevos.\",\"Se evita probando en datos que el método nunca vio. Por eso los umbrales y la mezcla se eligieron con 2022–2025 y se probaron en 2025–2026.\",\"\"],temporal:[\"Validación temporal\",\"Probar un método solo con información anterior a cada partido.\",\"Para cada partido, el modelo se calcula con los partidos jugados antes de esa fecha. Así no se usa información del futuro.\",\"\"],ah:[\"Hándicap asiático\",\"Se le suma o resta una ventaja de goles a un equipo; con líneas enteras o de cuarto puede haber devolución.\",'Línea entera (−1): si gana por 1 te devuelven todo. Línea media (−0,5): no hay devolución. Línea de cuarto (−0,25): la mitad va a 0 y la mitad a −0,5, así que podés ganar o perder la mitad. La herramienta \"Hándicap asiático\" calcula cada caso.',\"Local −0,25 y empatan: perdés la mitad y te devuelven la otra mitad.\"],he:[\"Hándicap europeo\",\"Como el asiático pero con tres resultados posibles y sin devoluciones.\",'Local −1 en europeo: si gana por 1, gana la apuesta del \"empate con hándicap\".',\"\"],dc:[\"Doble oportunidad\",\"Ganás con dos de los tres resultados: local o empate, empate o visitante, local o visitante.\",\"Su cuota justa es 1 ÷ (suma de las dos probabilidades). Paga poco porque acierta mucho.\",\"Local 45% + empate 28% → cuota justa 1,37.\"],dnb:[\"Empate no apuesta\",\"Apostás a un equipo; si empatan te devuelven la plata.\",\"Cuota justa = (prob. local + prob. visitante) ÷ prob. del equipo elegido. Equivale al hándicap asiático 0.\",\"\"],btts:[\"Ambos marcan\",\"Que los dos equipos hagan al menos un gol.\",\"Sin cuotas de este mercado en la fuente, la página lo estima con Poisson a partir de los goles esperados: es una estimación, no un precio.\",\"\"],ou:[\"Más / menos goles\",\"Si el total de goles supera una línea (2,5, por ejemplo).\",\"Con líneas medias (2,5) no hay devolución. La fuente publica cuotas de 2,5; otras líneas se estiman con Poisson.\",\"Más de 2,5 = 3 goles o más.\"],exacto:[\"Resultado exacto\",\"Acertar el marcador final.\",\"Aun el resultado más probable sale pocas veces (10–14%). Se estima con Poisson y Dixon-Coles; sin cuotas en la fuente.\",\"\"],htft:[\"Descanso / final\",\"Acertar quién va ganando al descanso y quién gana al final.\",\"No disponible: la fuente no publica cuotas de este mercado para partidos próximos.\",\"\"],corners:[\"Córners\",\"Cantidad de tiros de esquina.\",\"La fuente no publica cuotas de córners. La página muestra los promedios de cada equipo y la probabilidad de un modelo propio (córners que genera y concede cada equipo, con más peso a lo reciente), probado con más de 15.000 partidos fuera de muestra. Sin cuota de referencia no calcula valor: compará la cuota justa con la de tu casa.\",\"Si la cuota justa de 'más de 9,5 córners' es 1,85 y tu casa paga 2,00, hay valor según el modelo.\"],tarjetas:[\"Tarjetas\",\"Amarillas y rojas (en la página, amarilla = 1 y roja = 2).\",\"Sin cuotas en la fuente. El modelo propio estima el total de amarillas del partido (probado con más de 16.000 partidos fuera de muestra). Las reglas de conteo cambian según la casa (algunas cuentan la roja como 2): revisalas antes de apostar.\",\"\"],jugadores:[\"Mercados de jugadores\",\"Goles, remates o asistencias de un jugador.\",\"No disponible: haría falta saber quién juega y cuántos minutos, y la fuente no lo publica. No se estiman.\",\"\"],acierto:[\"Acertar ≠ tener valor ≠ ganar plata\",\"Acertar un resultado no significa que la apuesta fuera buena, y una buena apuesta puede perderse.\",\"Una decisión de valor es apostar cuando la cuota paga más de lo justo. La rentabilidad sostenida solo se ve después de cientos de apuestas. Por eso se mide el CLV además del resultado.\",\"Apostar al favorito a 1,20 y acertar puede ser mala decisión si lo justo era 1,30.\"],frescura:[\"Estado de los datos\",\"Cuánto hace que se capturaron las cuotas.\",\"Verde: menos de 12 h, las señales valen. Amarillo: 12 a 48 h, se muestran en gris porque la cuota pudo cambiar. Rojo: más de 48 h, no se marcan señales. La fuente actualiza sus cuotas 2 o 3 veces por semana. Los límites se cambian en Más → Ajustes.\",\"\"],mejor:[\"Mejor cuota publicada\",\"La cuota más alta entre todas las casas que releva la fuente.\",\"Si la da una casa identificada (Bet365, Betfred, BetVictor, Bwin, Paddy Power, Sky Bet, Pinnacle), se muestra su nombre. Si no, es una casa no identificada que puede no operar en Argentina. Las casas argentinas (Betano, BetWarrior, Casino Club, etc.) no publican sus cuotas de forma abierta: cargá la de tu casa en la ficha del partido.\",\"\"],unidad:[\"Unidad\",\"Lo que apostás cada vez: el 1% de la plata que separaste para apostar.\",\"Apostar siempre lo mismo te protege de las rachas. El ¼ de Kelly es un tope, no una recomendación: depende de una probabilidad estimada que tiene error.\",\"Banca $200.000 → unidad $2.000.\"],kelly:[\"Criterio de Kelly\",\"Una fórmula que dice qué parte de la banca apostar según la ventaja.\",\"Kelly completo = (b·p − q) ÷ b, con b = cuota − 1. Supone que la probabilidad es exacta, y no lo es: por eso se usa un cuarto y como tope. Con errores de estimación, Kelly completo puede fundirte.\",\"\"],incertidumbre:[\"Rango de incertidumbre\",\"Cuánto cambia el valor esperado si se calcula la probabilidad justa de otra manera razonable.\",\"Se recalcula la probabilidad sin margen con cada referencia disponible (Betfair Exchange, Pinnacle, promedio de casas) y con dos métodos (potencia y proporcional). El rango va del valor más bajo al más alto. No es un intervalo estadístico formal: muestra cuánto depende la señal de supuestos. Si el extremo bajo es cero o negativo, la ventaja no es robusta.\",\"Valor +4,9% con rango +1,2% a +6,0%: la señal existe con todas las referencias. Rango −0,8% a +5%: con una referencia distinta desaparece.\"],sensibilidad:[\"Análisis de sensibilidad\",\"Probar la misma regla con otros umbrales para ver si el resultado depende de un número elegido a dedo.\",\"Si el rendimiento solo es bueno con una combinación exacta de umbrales, probablemente es casualidad o sobreajuste. Elegir la mejor combinación mirando todos los datos infla el resultado; por eso se elige con temporadas viejas y se prueba en las nuevas.\",\"De 36 combinaciones, la mejor dio +4,1%; probada en temporadas que no se usaron para elegirla dio +3,7% ± 7,7%: no se puede afirmar que sea mejor.\"],liquidacion:[\"Reglas de liquidación\",\"Cómo se decide si una apuesta gana, pierde, se devuelve o se paga a medias.\",\"Cada casa publica sus reglas: si cuenta la prórroga, qué pasa si se suspende el partido, cómo se pagan las líneas de cuarto de gol. Dos cuotas solo son comparables si se liquidan igual.\",\"En la mayoría de las casas, el 1X2 se liquida a los 90 minutos más el descuento, sin prórroga ni penales.\"],exposicion:[\"Exposición abierta\",\"Cuánta plata tenés apostada en partidos que todavía no terminaron.\",\"Es lo máximo que podrías perder ya mismo si todas las apuestas pendientes salen mal. Conviene que sea una parte chica de tu banca.\",\"3 apuestas pendientes de $2.000: exposición $6.000.\"],h2h:[\"Historial de enfrentamientos\",\"Resultados anteriores entre los dos equipos.\",\"Es un dato secundario: los planteles cambian, la muestra suele ser chica y el mercado ya lo considera. No conviene darle más peso que a la forma reciente o a las cuotas.\",\"Ganó el local 2 de los últimos 4 cruces: con 4 partidos, eso casi no dice nada.\"]},API=\"https://script.google.com/macros/s/AKfycbxR2phSdvly1VeKvTZcAjF0HZuPsk2WQze1Pv2H3crIiU23p_shqYWqp5HkhC4IAR8SKg/exec\",VALID={sensibilidad:[{cuota:\"max\",vmin:.01,vmax:.15,omax:4,n:18116,roi:.034,err:.019},{cuota:\"max\",vmin:.01,vmax:.15,omax:8,n:20524,roi:.0219,err:.0195},{cuota:\"max\",vmin:.01,vmax:.15,omax:15,n:20972,roi:.0161,err:.02},{cuota:\"max\",vmin:.01,vmax:.25,omax:4,n:18141,roi:.0345,err:.019},{cuota:\"max\",vmin:.01,vmax:.25,omax:8,n:20566,roi:.0222,err:.0195},{cuota:\"max\",vmin:.01,vmax:.25,omax:15,n:21032,roi:.0153,err:.02},{cuota:\"max\",vmin:.01,vmax:.5,omax:4,n:18149,roi:.0345,err:.019},{cuota:\"max\",vmin:.01,vmax:.5,omax:8,n:20574,roi:.0225,err:.0195},{cuota:\"max\",vmin:.01,vmax:.5,omax:15,n:21049,roi:.0151,err:.02},{cuota:\"max\",vmin:.02,vmax:.15,omax:4,n:9846,roi:.04,err:.0269},{cuota:\"max\",vmin:.02,vmax:.15,omax:8,n:11700,roi:.0207,err:.027},{cuota:\"max\",vmin:.02,vmax:.15,omax:15,n:12149,roi:.0127,err:.0278},{cuota:\"max\",vmin:.02,vmax:.25,omax:4,n:9872,roi:.0407,err:.0268},{cuota:\"max\",vmin:.02,vmax:.25,omax:8,n:11745,roi:.021,err:.027},{cuota:\"max\",vmin:.02,vmax:.25,omax:15,n:12214,roi:.0113,err:.0278},{cuota:\"max\",vmin:.02,vmax:.5,omax:4,n:9880,roi:.0407,err:.0268},{cuota:\"max\",vmin:.02,vmax:.5,omax:8,n:11753,roi:.0214,err:.027},{cuota:\"max\",vmin:.02,vmax:.5,omax:15,n:12231,roi:.0109,err:.0277},{cuota:\"max\",vmin:.03,vmax:.15,omax:4,n:5211,roi:.