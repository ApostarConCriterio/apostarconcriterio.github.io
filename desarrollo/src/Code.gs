  Object.keys(t).forEach(function (x) {
    var s = t[x];
    out.teams[x] = {
      attH: (s.gfH + K * mh) / (s.wH + K) / mh, defH: (s.gaH + K * ma) / (s.wH + K) / ma,
      attA: (s.gfA + K * ma) / (s.wA + K) / ma, defA: (s.gaA + K * mh) / (s.wA + K) / mh, n: s.n
